# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Instagram Account Credentials
# Create a dedicated Instagram account for the bot (recommended)
# DO NOT use your personal account
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# Download Configuration
DOWNLOAD_DIR=./downloads

# Session File (stores Instagram login session)
# This file will be created automatically after first login
SESSION_FILE=./instagram_session.json

# Optional: Admin User ID for notifications
# ADMIN_USER_ID=your_telegram_user_id
